@tailwind base;
@tailwind components;
@tailwind utilities;

/* ============================================================
   AETHER-LOGOS — Dark "Lucid Techy" Design System
   ============================================================ */

:root {
  /* Light Mode (Default) */
  --bg: #ffffff;
  --text: #000000;
  --bg-base: #f8fafc;
  --bg-surface: #ffffff;
  --bg-elevated: #f1f5f9;
  --bg-hover: #e2e8f0;

  --border: #e2e8f0;
  --border-accent: #0ea5e9;
  --border-hover: #0284c7;

  --cyan: #0ea5e9;
  --cyan-dim: rgba(14, 165, 233, 0.1);
  --violet: #6366f1;
  --violet-dim: rgba(99, 102, 241, 0.1);
  --green: #059669;
  --green-dim: rgba(5, 150, 105, 0.1);
  --amber: #d97706;
  --red: #dc2626;

  --text-primary: #0f172a;
  --text-secondary: #334155;
  --text-muted: #64748b;
  --text-inverse: #ffffff;

  /* Typography */
  --font-sans: var(--font-inter), ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --font-mono: var(--font-roboto-mono), ui-monospace, "SFMono-Regular", monospace;

  /* Radius */
  --radius-sm: 6px;
  --radius-md: 10px;
  --radius-lg: 16px;
  --radius-pill: 9999px;

  /* Shadows / glows */
  --glow-cyan: 0 0 15px rgba(14, 165, 233, 0.3);
  --glow-violet: 0 0 15px rgba(99, 102, 241, 0.3);
  --shadow-card: 0 4px 20px rgba(0, 0, 0, 0.05), inset 0 1px 0 rgba(255,255,255,0.6);

  /* Transitions */
  --transition: 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.dark {
  --bg: #0a0a0f;
  --text: #ffffff;
  --bg-base: #060913;
  --bg-surface: rgba(255, 255, 255, 0.03);
  --bg-elevated: rgba(255, 255, 255, 0.06);
  --bg-hover: rgba(255, 255, 255, 0.09);

  --border: rgba(255, 255, 255, 0.06);
  --border-accent: rgba(0, 212, 255, 0.3);
  --border-hover: rgba(0, 212, 255, 0.5);

  --cyan: #00d4ff;
  --cyan-dim: rgba(0, 212, 255, 0.12);
  --violet: #8b5cf6;
  --violet-dim: rgba(139, 92, 246, 0.15);
  --green: #10b981;
  --green-dim: rgba(16, 185, 129, 0.15);
  --amber: #f59e0b;
  --red: #ef4444;

  --text-primary: #f8fafc;
  --text-secondary: #cbd5e1;
  --text-muted: #64748b;
  --text-inverse: #0f172a;

  --glow-cyan: 0 0 20px rgba(0, 212, 255, 0.3);
  --glow-violet: 0 0 20px rgba(139, 92, 246, 0.3);
  --shadow-card: 0 8px 32px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255,255,255,0.05);
}

/* ---- Reset & base ---------------------------------------- */

*,
*::before,
*::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: var(--font-sans);
  background-color: var(--bg);
  color: var(--text);
  min-height: 100vh;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

a {
  color: var(--cyan);
  text-decoration: none;
  transition: color var(--transition);
}

a:hover {
  color: #fff;
}

/* ---- Glass card ------------------------------------------ */

.glass {
  background: var(--bg-surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
}

.glass:hover {
  border-color: var(--border-accent);
  box-shadow: var(--shadow-card);
}

/* ---- Buttons --------------------------------------------- */

.btn-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.4rem;
  padding: 0.65rem 1.4rem;
  background: var(--cyan);
  color: var(--text-inverse);
  font-weight: 700;
  font-size: 0.9rem;
  border: none;
  border-radius: var(--radius-md);
  cursor: pointer;
  transition: filter var(--transition), box-shadow var(--transition);
}

.btn-primary:hover:not(:disabled) {
  filter: brightness(1.15);
  box-shadow: var(--glow-cyan);
}

.btn-primary:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}

.btn-ghost {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.4rem;
  padding: 0.6rem 1.2rem;
  background: transparent;
  color: var(--text-secondary);
  font-size: 0.9rem;
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  cursor: pointer;
  transition: border-color var(--transition), color var(--transition);
}

.btn-ghost:hover:not(:disabled) {
  border-color: var(--border-accent);
  color: var(--text-primary);
}

.btn-danger {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.5rem 1rem;
  background: rgba(244, 63, 94, 0.15);
  color: var(--red);
  font-size: 0.85rem;
  border: 1px solid rgba(244, 63, 94, 0.3);
  border-radius: var(--radius-md);
  cursor: pointer;
  transition: background var(--transition);
}

.btn-danger:hover:not(:disabled) {
  background: rgba(244, 63, 94, 0.25);
}

/* ---- Form controls --------------------------------------- */

.input {
  display: block;
  width: 100%;
  padding: 0.55rem 0.9rem;
  background: var(--bg-surface);
  color: var(--text-primary);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  font-size: 0.9rem;
  font-family: var(--font-sans);
  outline: none;
  transition: border-color var(--transition), box-shadow var(--transition);
}

.input:focus {
  border-color: var(--cyan);
  box-shadow: 0 0 0 3px rgba(0, 212, 255, 0.12);
}

.input::placeholder {
  color: var(--text-muted);
}

select.input,
textarea.input {
  background-image: none;
}

select.input {
  appearance: none;
  -webkit-appearance: none;
  cursor: pointer;
}

/* ---- Form utilities (semantic aliases) ------------------- */

.form-group {
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
}

.form-label {
  font-size: 0.82rem;
  font-weight: 600;
  color: var(--text-secondary);
  letter-spacing: 0.02em;
}

.form-input {
  display: block;
  width: 100%;
  padding: 0.55rem 0.9rem;
  background: var(--bg-surface);
  color: var(--text-primary);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  font-size: 0.9rem;
  font-family: var(--font-sans);
  outline: none;
  transition: border-color var(--transition), box-shadow var(--transition);
}

.form-input:focus {
  border-color: var(--cyan);
  box-shadow: 0 0 0 3px rgba(0, 212, 255, 0.12);
}

.form-input::placeholder {
  color: var(--text-muted);
}

select.form-input {
  appearance: none;
  -webkit-appearance: none;
  cursor: pointer;
}

.form-hint {
  font-size: 0.75rem;
  color: var(--text-muted);
  text-align: right;
}

/* ---- Badges ---------------------------------------------- */

.badge {
  display: inline-flex;
  align-items: center;
  padding: 0.15rem 0.55rem;
  border-radius: var(--radius-pill);
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.02em;
}

.badge-cyan { background: var(--cyan-dim); color: var(--cyan); border: 1px solid var(--border-accent); }
.badge-violet { background: var(--violet-dim); color: #a78bfa; border: 1px solid rgba(124,58,237,0.3); }
.badge-green { background: var(--green-dim); color: var(--green); border: 1px solid rgba(0,255,136,0.25); }
.badge-amber { background: rgba(245,158,11,0.12); color: var(--amber); border: 1px solid rgba(245,158,11,0.3); }
.badge-red { background: rgba(244,63,94,0.12); color: var(--red); border: 1px solid rgba(244,63,94,0.25); }

/* ---- Skeleton loader ------------------------------------- */

@keyframes skeleton-pulse {
  0%, 100% { opacity: 0.4; }
  50% { opacity: 0.8; }
}

.skeleton {
  background: var(--bg-elevated);
  border-radius: var(--radius-sm);
  animation: skeleton-pulse 1.4s ease-in-out infinite;
}

/* ---- Scrollbar ------------------------------------------- */

::-webkit-scrollbar { width: 6px; height: 6px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: var(--border); border-radius: var(--radius-pill); }
::-webkit-scrollbar-thumb:hover { background: var(--text-muted); }

/* ---- Address / mono text --------------------------------- */

.addr {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  color: var(--text-muted);
  letter-spacing: 0.02em;
}

.hide-scrollbar::-webkit-scrollbar { display: none; }
.hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

/* ---- Animated mesh background for hero ------------------- */

@keyframes gradient-shift {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

.hero-mesh {
  background: linear-gradient(-45deg, var(--bg-base), rgba(0, 212, 255, 0.1), rgba(124, 58, 237, 0.1), var(--bg-base));
  background-size: 400% 400%;
  animation: gradient-shift 15s ease infinite;
}

:root:not(.dark) .hero-mesh {
  background: linear-gradient(-45deg, var(--bg-base), rgba(14, 165, 233, 0.15), rgba(99, 102, 241, 0.15), var(--bg-base));
  background-size: 400% 400%;
  animation: gradient-shift 15s ease infinite;
}

/* ---- Page container -------------------------------------- */

.page-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 2rem 1.25rem;
}

/* ---- Wallet adapter button override ---------------------- */

.wallet-adapter-button {
  background: var(--cyan-dim) !important;
  color: var(--cyan) !important;
  border: 1px solid var(--border-accent) !important;
  border-radius: var(--radius-md) !important;
  font-size: 0.85rem !important;
  font-weight: 600 !important;
  height: 38px !important;
  padding: 0 1rem !important;
  transition: filter var(--transition), box-shadow var(--transition) !important;
}

.wallet-adapter-button:hover {
  filter: brightness(1.2) !important;
  box-shadow: var(--glow-cyan) !important;
}

.wallet-adapter-modal-wrapper {
  background: #111827 !important;
  border: 1px solid var(--border) !important;
  border-radius: var(--radius-lg) !important;
}

.wallet-adapter-modal-title {
  color: var(--text-primary) !important;
}

.wallet-adapter-modal-list li button {
  color: var(--text-primary) !important;
}

/* ---- Accessibility: focus-visible ring ------------------- */

:focus-visible {
  outline: 2px solid var(--cyan);
  outline-offset: 2px;
  border-radius: var(--radius-sm);
}

/* ---- CartDrawer slide animation -------------------------- */

@keyframes slide-in-right {
  from { transform: translateX(100%); }
  to   { transform: translateX(0); }
}

@keyframes slide-out-right {
  from { transform: translateX(0); }
  to   { transform: translateX(100%); }
}

.cart-drawer-enter { animation: slide-in-right 0.28s cubic-bezier(0.22,1,0.36,1) forwards; }
.cart-drawer-exit  { animation: slide-out-right 0.22s ease-in forwards; }

/* ---- Listing grid ---------------------------------------- */

.listing-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 1.25rem;
}

/* ---- Vendor layout (sidebar + content) ------------------- */

.vendor-layout {
  display: flex;
  gap: 2rem;
}

/* ---- Mobile breakpoints ---------------------------------- */

@media (max-width: 900px) {
  /* NavBar: hide text labels, compress */
  .nav-text-label { display: none; }
}

@media (max-width: 768px) {
  .page-container { padding: 1.25rem 1rem; }

  /* Vendor dashboard sidebar → horizontal scroll strip */
  .vendor-layout { flex-direction: column; }
  nav.vendor-sidebar {
    flex-direction: row;
    overflow-x: auto;
    border-right: none !important;
    border-bottom: 1px solid var(--border);
    padding-right: 0 !important;
    padding-bottom: 0.6rem;
    gap: 0.25rem;
    min-width: unset;
    width: 100%;
  }

  /* Search page: remove sidebar grid, stack vertically */
  .search-layout { grid-template-columns: 1fr !important; }
  .search-sidebar { display: none; }

  /* Listing grid: 2 columns */
  .listing-grid { grid-template-columns: repeat(2, 1fr); }

  /* Hero stats bar: wrap */
  .stats-bar { flex-wrap: wrap; gap: 0.75rem; }

  /* Cart drawer: full width on mobile */
  .cart-drawer-panel { width: 100vw !important; }

  /* Checkout: stack */
  .checkout-grid { grid-template-columns: 1fr !important; }
}

@media (max-width: 480px) {
  .page-container { padding: 1rem 0.75rem; }
  .listing-grid { grid-template-columns: 1fr; }

  /* NavBar: hide most links */
  .nav-links-desktop { display: none; }

  /* Hero section: reduce padding */
  .hero-section { padding: 2.5rem 1rem 2rem !important; }

  /* Buttons: full width on very small screens */
  .btn-primary-mobile-full { width: 100%; }
}

