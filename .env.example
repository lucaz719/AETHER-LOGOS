# ============================================================
# AETHER-LOGOS — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.

# ── Solana ──────────────────────────────────────────────────
SOLANA_RPC_URL=https://api.devnet.solana.com
ANCHOR_WALLET=~/.config/solana/id.json
ANCHOR_PROVIDER_URL=https://api.devnet.solana.com

# ── Reclaim Protocol (zkTLS) ────────────────────────────────
RECLAIM_APP_ID=your_app_id_here
RECLAIM_APP_SECRET=your_app_secret_here
MOCK_PROOF=true

# ── Agent ────────────────────────────────────────────────────
AGENT_PORT=8080
AGENT_DB_PATH=./agent.db
# NOTE: env var name used inside Go agent — must match exactly
SOLANA_RPC=https://api.devnet.solana.com
MARKETPLACE_PROGRAM_ID=Fg6PaFpoGXkYsidMpWTK6W2BeZ7FEfcYkg476zPFsLnN

# ── Carrier API Keys ─────────────────────────────────────────
DHL_API_KEY=your_dhl_api_key_here
FEDEX_API_KEY=your_fedex_api_key_here

# ── Frontend (Next.js public vars) ───────────────────────────
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# trade_escrow program deployed on devnet
NEXT_PUBLIC_TRADE_ESCROW_PROGRAM_ID=EVn3aVUGYbx6yvHa5h4m5N3qfJkhKm1FnYeNsfbi34CZ
NEXT_PUBLIC_PREDICTION_MARKET_PROGRAM_ID=HmbTLCmaGtYhSJafyMNx2YdAfJvpGAE2x5JRf8kzGiuY
NEXT_PUBLIC_MARKETPLACE_PROGRAM_ID=Fg6PaFpoGXkYsidMpWTK6W2BeZ7FEfcYkg476zPFsLnN

# ── IPFS / Pinata (image uploads) ────────────────────────────
PINATA_JWT=your_pinata_jwt_here
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs
